# PulseAudio runtime symlinks created by Chromium under Playwright.
# These point at /tmp/pulse-XXXX dirs that get cleaned up on workflow
# exit, leaving dangling symlinks that the deployment build warns about
# ("Detected broken symlink") on every Repl layer push.
.config/pulse/

# Task #5 queue-monitor persisted streak/cooldown state
.queue-monitor-state.json

